# Leave DATABASE_URL unset for local/dev → in-memory PGlite (no cloud DB).
# Hosted Cursor publish-app sets DATABASE_URL automatically when cursor-app.json
# declares { "database": "postgres" }.
# DATABASE_URL=postgresql://user:pass@host:5432/key2hr

# Required in production/hosted. Used to sign session cookies.
# Local/dev falls back to a non-secret demo default when unset.
# Set via Cursor app secrets for publish-app (do not commit real values).
AUTH_SECRET=replace-with-a-long-random-string
