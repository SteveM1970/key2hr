# Leave DATABASE_URL unset for local/dev → in-memory PGlite (no cloud DB).
# Hosted Cursor publish-app sets DATABASE_URL automatically when cursor-app.json
# declares { "database": "postgres" }.
# DATABASE_URL=postgresql://user:pass@host:5432/key2hr

# Required. Used to sign session cookies. No in-app fallback.
# Local: set in .env.local. Hosted: set via Cursor app secrets.
AUTH_SECRET=

# Optional. When set, first-time seed creates demo user password hashes.
# Never committed — use .env.local locally, or Cursor app secrets when hosted.
# Role-specific overrides: KEY2HR_DEMO_ADMIN_PASSWORD, KEY2HR_DEMO_MANAGER_PASSWORD,
# KEY2HR_DEMO_STAFF_PASSWORD.
# KEY2HR_DEMO_PASSWORD=
